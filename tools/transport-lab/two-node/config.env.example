# Copy to config.env. Run all entries on machine A; B uses key-based SSH.
B_SSH=user@machine-b
SSH_OPTIONS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3)
A_IP=192.0.2.10
B_IP=192.0.2.11
A_PACKAGE="$HOME/ub-source/ultrashuffle-rm-ctp/spark-3.5.7-rm-ctp-benchmark-aarch64"
A_WORK="$HOME/ub-source/ultrashuffle-rm-ctp-work/ub-two-node"
B_PACKAGE=/opt/ultrashuffle-rm-ctp/spark-3.5.7-rm-ctp-benchmark-aarch64
B_WORK=/var/tmp/ultrashuffle-rm-ctp-work
A_DEVICE=auto
B_DEVICE=auto
A_PROVIDER=auto
B_PROVIDER=auto
A_EID=auto
B_EID=auto
# Optional installed vendor SDK prefixes/additional search roots, not source trees.
A_SDK_ROOT=
B_SDK_ROOT=
A_SEARCH_ROOTS=()
B_SEARCH_ROOTS=()
# rm-ctp: experimental native and application path in this isolated build.
# rc-rtp: use only after the vendor confirms RC is usable.
MODE=rm-ctp
A_PRIORITY=auto
B_PRIORITY=auto
# Optional measurement-only flags, applied identically to both perftest ends.
# These are NOT forwarded to SCache. Do not switch simplex/flat API, TP-aware,
# user TP, async import, ordering, token policy or context aggregation here.
# Such alternate paths need a matching JNI adapter and separate validation.
# For bonding RC use --single_path if the installed tool supports it.
NATIVE_EXTRA_ARGS=()
# "application" resolves to the smaller endpoint's actual SCache URMA
# subrequest limit: min(UB_CHUNK_BYTES, max_msg_size, max_read_size,
# max_write_size).
NATIVE_SIZES=(4096 application)
NATIVE_TIMEOUT=180
NATIVE_PORT=19190
ARENA_MIB=128
BENCH_ARENA_MIB=2048
# Native transport caps each raw READ/WRITE to the provider-reported limit;
# 10 MiB here is the logical SCache chunk target, not a claim that hardware
# accepts a 10 MiB raw WQE.
UB_CHUNK_BYTES=10485760
APP_TIMEOUT=7200
# Existing shared filesystem, same absolute path on A and B, for phases 60/70.
# Scripts verify cross-host visibility both ways; they do not configure NFS.
SHARED_ROOT=/mnt/ub-benchmark-shared
